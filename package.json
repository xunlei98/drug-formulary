{
  "name": "limbang-formulary",
  "version": "1.0.0",
  "description": "Hospital Limbang drug formulary PWA on Firebase (Spark plan)",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-limbang-rules \"node --test test/rules/\"",
    "test:e2e": "npm run build && firebase emulators:exec --only auth,firestore --project demo-limbang-formulary \"node --test --test-concurrency=1 test/e2e/*.e2e.js\"",
    "test:all": "npm test && npm run test:rules && npm run test:e2e",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-limbang-formulary",
    "seed:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 node scripts/seed-cloud.js",
    "admin:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 node scripts/cloud-admin.js",
    "deploy": "firebase deploy --only firestore:rules,firestore:indexes,hosting --project ${FIREBASE_PROJECT:-default}",
    "seed:cloud": "node scripts/seed-cloud.js",
    "cloud:admin": "node scripts/cloud-admin.js",
    "dev": "npm run build && node scripts/serve-local.js",
    "screens": "npm run build && firebase emulators:exec --only auth,firestore --project demo-limbang-formulary \"node scripts/screens-kad.js\"",
    "photos": "node scripts/host-drug-photos.js",
    "notion:merge": "node scripts/merge-notion.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "esbuild": "^0.28.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.34.2",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5"
  }
}
